# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used for reply classification.
# Opus 5 is the default for accuracy on the compliance-critical classes.
# See SPEC.md "Model choice" for the cost/accuracy tradeoff.
TRIAGE_MODEL=claude-opus-5

# Feature flags. Anything not listed here defaults to OFF.
# AUTO_SEND is intentionally unfinished and ships dark — see SPEC.md.
FLAG_AUTO_SEND=false

PORT=4000
